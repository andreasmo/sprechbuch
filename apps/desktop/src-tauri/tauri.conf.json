{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sprechbuch",
  "version": "0.1.0",
  "identifier": "org.sprechbuch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sprechbuch",
        "width": 1240,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Sprechbuch contributors",
    "shortDescription": "Bücher als Leseskript für die Hörbuch-Aufnahme",
    "category": "Productivity",
    "copyright": "MIT License",
    "fileAssociations": [
      {
        "ext": ["hbook"],
        "name": "Sprechbuch",
        "description": "Sprechbuch-Datei",
        "mimeType": "application/vnd.sprechbuch.book+zip",
        "role": "Editor",
        "exportedType": {
          "identifier": "org.sprechbuch.hbook",
          "conformsTo": ["public.data", "public.zip-archive"]
        }
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  }
}